# Copia este archivo como .env.local (en tu computadora) o captura estas
# variables en Vercel → Settings → Environment Variables.
# NUNCA subas los valores reales a GitHub.

# Supabase → Project Settings → API (o "API Keys")
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Llave pública: "anon public" o "Publishable key" (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Llave SECRETA: "service_role" o "Secret key" (sb_secret_...). Solo va en el servidor.
SUPABASE_SERVICE_ROLE_KEY=

# Dirección pública de tu app (sin diagonal al final), p. ej. https://sellos.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Texto aleatorio largo para proteger las IP en los límites de intentos.
# Genera uno en https://www.random.org/strings/ o con: openssl rand -hex 32
IP_HASH_SALT=
